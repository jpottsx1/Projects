// The Safari extension's settings: everything in Stash.xcconfig (change
// things there, not here). It hands pages to the app through the App Group,
// so it uses the share extension's entitlements, switched on by SHARE_EXTENSION.
#include "Stash.xcconfig"

STASH_SAFARI_ENTITLEMENTS_YES = Config/ShareExtension.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*] = $(STASH_SAFARI_ENTITLEMENTS_$(SHARE_EXTENSION))
CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*] = $(STASH_SAFARI_ENTITLEMENTS_$(SHARE_EXTENSION))
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = $(STASH_SAFARI_ENTITLEMENTS_$(SHARE_EXTENSION))
